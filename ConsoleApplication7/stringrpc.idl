interface stringrpc
{
    int CountVowels(
        [in] handle_t hBinding,
        [string][in] unsigned char* str
    );

    int CountWords(
        [in] handle_t hBinding,
        [string][in] unsigned char* str
    );

    boolean IsPalindrome(
        [in] handle_t hBinding,
        [string][in] unsigned char* str
    );
}
